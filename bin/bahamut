#!/usr/bin/env bash
# Bahamut XI server management.
#
#   sudo bin/bahamut install        First-time setup of a fresh Ubuntu 26.04 server
#   sudo bin/bahamut update         Move to PHOENIX_REF, rebuild, update the database, restart
#   sudo bin/bahamut web-update     Pull, build and restart the website
#        bin/bahamut status         Service status and players online
#   sudo bin/bahamut start|stop|restart [game|web|all]
#        bin/bahamut logs [world|connect|search|map|profile|web]
#   sudo bin/bahamut backup         Dump both databases now
#   sudo bin/bahamut apply          Re-copy this repo's settings into the server
#   sudo bin/bahamut build          Rebuild the game servers only
#   sudo bin/bahamut db-update      Apply new SQL and migrations (dbtool update)
#   sudo bin/bahamut gm <account> <level>   Give every character on an account a GM level (0-5)
#
# Configuration: /etc/bahamut/bahamut.conf (from config/bahamut.conf.example).

set -Eeuo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
ETC_DIR="/etc/bahamut"
CONF="$ETC_DIR/bahamut.conf"
SERVER_ENV="$ETC_DIR/server.env"
WEB_ENV="$ETC_DIR/web.env"

GAME_UNITS=(bahamut-world bahamut-connect bahamut-search bahamut-map bahamut-profile)
WEB_UNITS=(bahamut-web)

# ---- helpers -------------------------------------------------------------------------------

c_info=$'\e[1;36m'; c_ok=$'\e[1;32m'; c_warn=$'\e[1;33m'; c_err=$'\e[1;31m'; c_off=$'\e[0m'
[[ -t 1 ]] || { c_info=''; c_ok=''; c_warn=''; c_err=''; c_off=''; }
step() { printf '%s==>%s %s\n' "$c_info" "$c_off" "$*"; }
ok()   { printf '%s ok%s %s\n' "$c_ok" "$c_off" "$*"; }
warn() { printf '%swarning:%s %s\n' "$c_warn" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_err" "$c_off" "$*" >&2; exit 1; }
trap 'die "command failed (line $LINENO): $BASH_COMMAND"' ERR

need_root() { [[ $EUID -eq 0 ]] || die "run this with sudo: sudo $0 $*"; }

load_conf() {
  if [[ -f "$CONF" ]]; then
    # shellcheck source=/dev/null
    source "$CONF"
  else
    # shellcheck source=/dev/null
    source "$REPO_DIR/config/bahamut.conf.example"
  fi
  SERVER_DIR="$BAHAMUT_ROOT/server"
  BUILD_DIR="$BAHAMUT_ROOT/build"
  VENV="$BAHAMUT_ROOT/venv"
  WEB_DIR="$BAHAMUT_ROOT/web"
  BACKUP_DIR="$BAHAMUT_ROOT/backups"
}

# Run a command as the service user.
as_user() { sudo -u "$BAHAMUT_USER" -H "$@"; }

# Read one KEY=value from an env file.
env_get() { grep -E "^$2=" "$1" | head -1 | cut -d= -f2-; }

random_secret() { openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c "${1:-32}"; }

mysql_root() { mysql --protocol=socket -uroot "$@"; }

# ---- install steps -------------------------------------------------------------------------

check_os() {
  # shellcheck source=/dev/null
  . /etc/os-release
  if [[ "${ID:-}" != "ubuntu" ]]; then
    die "Bahamut XI targets Ubuntu 26.04; this is ${PRETTY_NAME:-unknown}."
  fi
  if [[ "${VERSION_ID:-}" != "26.04" ]]; then
    warn "Bahamut XI is tested on Ubuntu 26.04; this is $PRETTY_NAME. Continuing."
  fi
}

install_packages() {
  step "Installing packages"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -q
  # Build and runtime dependencies from the Phoenix/LandSandBoat Ubuntu Dockerfile,
  # plus MariaDB, nginx, certbot, Node.js for the website and ufw.
  apt-get install -y -q --no-install-recommends \
    build-essential g++-15 cmake ninja-build ccache pkg-config git ca-certificates curl openssl \
    binutils-dev libdwarf-dev libluajit-5.1-dev libmariadb-dev-compat libssl-dev \
    libzmq3-dev zlib1g-dev libzstd-dev python3 python3-dev python3-venv \
    luajit lua5.1 libzmq5 \
    mariadb-server mariadb-client \
    nginx certbot python3-certbot-nginx \
    nodejs npm \
    ufw sudo tzdata
  update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-15 100
  update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-15 100

  local node_major
  node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
  if (( node_major < 20 )); then
    die "The website needs Node.js 20 or newer; Ubuntu's package is $(node -v 2>/dev/null || echo missing)."
  fi
  ok "packages (Node.js $(node -v))"
}

create_user_and_dirs() {
  step "Creating the $BAHAMUT_USER user and $BAHAMUT_ROOT"
  id "$BAHAMUT_USER" &>/dev/null || adduser --system --group --home "$BAHAMUT_ROOT" --shell /usr/sbin/nologin "$BAHAMUT_USER"
  install -d -o "$BAHAMUT_USER" -g "$BAHAMUT_USER" -m 0750 "$BAHAMUT_ROOT" "$BACKUP_DIR"
  install -d -o root -g "$BAHAMUT_USER" -m 0750 "$ETC_DIR"
  if [[ ! -f "$CONF" ]]; then
    install -o root -g "$BAHAMUT_USER" -m 0640 "$REPO_DIR/config/bahamut.conf.example" "$CONF"
    warn "Created $CONF with example values. Edit BAHAMUT_DOMAIN and BAHAMUT_ACME_EMAIL, then run install again."
    exit 0
  fi
  ok "user and folders"
}

write_secrets() {
  step "Database accounts and secrets"
  if [[ ! -f "$SERVER_ENV" ]]; then
    umask 077
    cat > "$SERVER_ENV" <<EOF
# Read by the game servers (LandSandBoat overrides settings from XI_<FILE>_<KEY> variables)
# and by dbtool. Generated by bin/bahamut install.
XI_NETWORK_SQL_LOGIN=bahamut_game
XI_NETWORK_SQL_PASSWORD=$(random_secret 32)
XI_NETWORK_SQL_DATABASE=$DB_NAME
EOF
    chown root:"$BAHAMUT_USER" "$SERVER_ENV"; chmod 0640 "$SERVER_ENV"
  fi
  if [[ ! -f "$WEB_ENV" ]]; then
    umask 077
    cat > "$WEB_ENV" <<EOF
# Read by the website (bahamut-web.service). Generated by bin/bahamut install.
NODE_ENV=production
PORT=$WEB_PORT
SITE_URL=https://$BAHAMUT_DOMAIN
FILES_URL=$BAHAMUT_FILES_URL
GAME_DB_HOST=127.0.0.1
GAME_DB_NAME=$DB_NAME
GAME_DB_USER=bahamut_web
GAME_DB_PASSWORD=$(random_secret 32)
WEB_DB_NAME=$WEB_DB_NAME
SESSION_SECRET=$(random_secret 64)
GAME_HTTP_API=http://127.0.0.1:8088
# Optional: outgoing mail for account e-mails (password resets). Leave empty to log
# reset links to the journal instead.
SMTP_URL=
MAIL_FROM="Bahamut XI <no-reply@$BAHAMUT_DOMAIN>"
# Optional: Discord invite shown on the site.
DISCORD_URL=
EOF
    chown root:"$BAHAMUT_USER" "$WEB_ENV"; chmod 0640 "$WEB_ENV"
  fi
  ok "$SERVER_ENV and $WEB_ENV"
}

setup_mariadb() {
  step "MariaDB"
  systemctl enable --now mariadb
  local game_pw web_pw
  game_pw="$(env_get "$SERVER_ENV" XI_NETWORK_SQL_PASSWORD)"
  web_pw="$(env_get "$WEB_ENV" GAME_DB_PASSWORD)"
  # Ubuntu's MariaDB lets root in through the unix socket only, which is what we want.
  mysql_root <<SQL
CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE DATABASE IF NOT EXISTS \`$WEB_DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE USER IF NOT EXISTS 'bahamut_game'@'localhost' IDENTIFIED BY '$game_pw';
CREATE USER IF NOT EXISTS 'bahamut_game'@'127.0.0.1' IDENTIFIED BY '$game_pw';
ALTER USER 'bahamut_game'@'localhost' IDENTIFIED BY '$game_pw';
ALTER USER 'bahamut_game'@'127.0.0.1' IDENTIFIED BY '$game_pw';
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO 'bahamut_game'@'localhost', 'bahamut_game'@'127.0.0.1';
CREATE USER IF NOT EXISTS 'bahamut_web'@'localhost' IDENTIFIED BY '$web_pw';
CREATE USER IF NOT EXISTS 'bahamut_web'@'127.0.0.1' IDENTIFIED BY '$web_pw';
ALTER USER 'bahamut_web'@'localhost' IDENTIFIED BY '$web_pw';
ALTER USER 'bahamut_web'@'127.0.0.1' IDENTIFIED BY '$web_pw';
GRANT ALL PRIVILEGES ON \`$WEB_DB_NAME\`.* TO 'bahamut_web'@'localhost', 'bahamut_web'@'127.0.0.1';
FLUSH PRIVILEGES;
SQL
  # Bind to localhost only: nothing outside this machine needs the database.
  cat > /etc/mysql/mariadb.conf.d/90-bahamut.cnf <<'EOF'
[mysqld]
bind-address = 127.0.0.1
character-set-server = utf8mb4
collation-server = utf8mb4_general_ci
EOF
  systemctl restart mariadb
  ok "databases $DB_NAME and $WEB_DB_NAME"
}

# The website reads game data and writes only accounts and launch tokens.
grant_web_access() {
  local tables
  tables="$(mysql_root -N -e "SELECT table_name FROM information_schema.tables WHERE table_schema='$DB_NAME'")"
  [[ -n "$tables" ]] || return 0
  mysql_root -e "GRANT SELECT ON \`$DB_NAME\`.* TO 'bahamut_web'@'localhost', 'bahamut_web'@'127.0.0.1';"
  local t
  for t in accounts accounts_login_tokens accounts_banned; do
    if grep -qx "$t" <<<"$tables"; then
      mysql_root -e "GRANT INSERT, UPDATE, DELETE ON \`$DB_NAME\`.\`$t\` TO 'bahamut_web'@'localhost', 'bahamut_web'@'127.0.0.1';"
    fi
  done
  mysql_root -e "FLUSH PRIVILEGES;"
}

fetch_phoenix() {
  step "Phoenix server source ($PHOENIX_REF)"
  if [[ ! -d "$SERVER_DIR/.git" ]]; then
    as_user git clone --filter=blob:none "$PHOENIX_REPO" "$SERVER_DIR"
  fi
  as_user git -C "$SERVER_DIR" fetch --tags origin
  # Keep local edits to tracked files out of the way, then move to the pinned commit.
  as_user git -C "$SERVER_DIR" checkout --force --detach "$PHOENIX_REF"
  as_user git -C "$SERVER_DIR" submodule update --init --recursive
  ok "server source at $(git -C "$SERVER_DIR" rev-parse --short HEAD)"
}

apply_overlay() {
  step "Applying Bahamut XI settings"
  local f
  for f in "$REPO_DIR"/settings/*.lua; do
    install -o "$BAHAMUT_USER" -g "$BAHAMUT_USER" -m 0644 "$f" "$SERVER_DIR/settings/$(basename "$f")"
  done
  if [[ -f "$REPO_DIR/modules/init.txt" ]]; then
    install -o "$BAHAMUT_USER" -g "$BAHAMUT_USER" -m 0644 "$REPO_DIR/modules/init.txt" "$SERVER_DIR/modules/init.txt"
  fi
  if [[ -d "$REPO_DIR/modules/bahamut" ]]; then
    rm -rf "$SERVER_DIR/modules/bahamut"
    cp -r "$REPO_DIR/modules/bahamut" "$SERVER_DIR/modules/bahamut"
    chown -R "$BAHAMUT_USER:$BAHAMUT_USER" "$SERVER_DIR/modules/bahamut"
  fi
  install -d -o "$BAHAMUT_USER" -g "$BAHAMUT_USER" "$SERVER_DIR/log"
  ok "settings copied into $SERVER_DIR/settings"
}

# Phoenix keeps core source changes its modules depend on in modules/temp_patch/*.patch
# (e.g. phoenix-fishing.patch adds the fishingutils hooks used by modules/phoenix/cpp/fishing_*.cpp).
# They are not committed to the source tree, so apply them before building. fetch_phoenix resets
# tracked files on every run, so this always starts from clean source.
apply_phoenix_patches() {
  step "Phoenix source patches"
  local dir="$SERVER_DIR/modules/temp_patch" p name
  shopt -s nullglob
  local patches=("$dir"/*.patch)
  shopt -u nullglob
  if (( ${#patches[@]} == 0 )); then
    ok "none to apply"
    return 0
  fi
  for p in "${patches[@]}"; do
    name="$(basename "$p")"
    if as_user git -C "$SERVER_DIR" apply --check "$p" 2>/dev/null; then
      as_user git -C "$SERVER_DIR" apply "$p"
      ok "applied $name"
    elif as_user git -C "$SERVER_DIR" apply -R --check "$p" 2>/dev/null; then
      ok "$name is already applied"
    else
      # Upstream has since merged or rewritten these changes; the build shows if anything still needs it.
      warn "$name doesn't apply to this Phoenix commit (already merged upstream or out of date); skipped"
    fi
  done
}

setup_python() {
  step "Python tools (dbtool)"
  [[ -x "$VENV/bin/python" ]] || as_user python3 -m venv "$VENV"
  as_user "$VENV/bin/pip" install -q --upgrade pip wheel
  as_user "$VENV/bin/pip" install -q -r "$SERVER_DIR/tools/requirements.txt"
  ok "venv at $VENV"
}

build_server() {
  step "Building the game servers (this takes a while the first time)"
  install -d -o "$BAHAMUT_USER" -g "$BAHAMUT_USER" "$BUILD_DIR"
  # Codegen runs Python scripts that need tools/requirements.txt (jinja2, jsonschema,
  # ruamel.yaml). Those live in our venv, so point CMake (and anything it runs) at it.
  [[ -x "$VENV/bin/python" ]] || setup_python
  local venv_path="$VENV/bin:$PATH"
  as_user env PATH="$venv_path" VIRTUAL_ENV="$VENV" CC=gcc-15 CXX=g++-15 CCACHE_DIR="$BAHAMUT_ROOT/.ccache" \
    cmake -G Ninja -S "$SERVER_DIR" -B "$BUILD_DIR" \
      -DPython_EXECUTABLE="$VENV/bin/python" -DPython3_EXECUTABLE="$VENV/bin/python" \
      -DCMAKE_BUILD_TYPE=Release -DPCH_ENABLE=ON -DTRACY_ENABLE=OFF -DWARNINGS_AS_ERRORS=FALSE
  as_user env PATH="$venv_path" VIRTUAL_ENV="$VENV" CCACHE_DIR="$BAHAMUT_ROOT/.ccache" cmake --build "$BUILD_DIR" -j"$(nproc)"
  local exe
  for exe in xi_connect xi_map xi_search xi_world xi_profile; do
    [[ -x "$SERVER_DIR/$exe" ]] || die "build finished but $SERVER_DIR/$exe is missing"
  done
  ok "xi_connect xi_map xi_search xi_world xi_profile"
}

dbtool() {
  # dbtool reads the login from the same XI_NETWORK_* variables the servers use.
  (
    set -a
    # shellcheck source=/dev/null
    source "$SERVER_ENV"
    set +a
    cd "$SERVER_DIR"
    as_user env XI_NETWORK_SQL_LOGIN="$XI_NETWORK_SQL_LOGIN" XI_NETWORK_SQL_PASSWORD="$XI_NETWORK_SQL_PASSWORD" \
      XI_NETWORK_SQL_DATABASE="$XI_NETWORK_SQL_DATABASE" "$VENV/bin/python" tools/dbtool.py "$@"
  )
}

setup_database() {
  step "Game database"
  local count
  count="$(mysql_root -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME'")"
  if [[ "$count" == "0" ]]; then
    # dbtool "setup" also runs CREATE DATABASE, which already exists; it then imports everything.
    dbtool setup "$DB_NAME" || true
    count="$(mysql_root -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME'")"
    [[ "$count" != "0" ]] || die "dbtool setup did not create any tables"
  else
    dbtool update
  fi
  grant_web_access
  ok "$DB_NAME ($count tables)"
}

install_units() {
  step "systemd services"
  local unit
  for unit in "$REPO_DIR"/systemd/*.service "$REPO_DIR"/systemd/*.target "$REPO_DIR"/systemd/*.timer; do
    [[ -e "$unit" ]] || continue
    sed -e "s#@ROOT@#$BAHAMUT_ROOT#g" -e "s#@USER@#$BAHAMUT_USER#g" -e "s#@REPO@#$REPO_DIR#g" \
      "$unit" > "/etc/systemd/system/$(basename "$unit")"
  done
  systemctl daemon-reload
  systemctl enable bahamut-game.target bahamut-backup.timer
  ok "bahamut-game.target, bahamut-web.service, bahamut-backup.timer"
}

setup_firewall() {
  step "Firewall"
  ufw allow OpenSSH >/dev/null
  ufw allow 'Nginx Full' >/dev/null
  # FFXI: login data/view/auth, search, profile and the map server (UDP).
  ufw allow 54230/tcp >/dev/null
  ufw allow 54230/udp >/dev/null
  ufw allow 54231/tcp >/dev/null
  ufw allow 54001/tcp >/dev/null
  ufw allow 54002/tcp >/dev/null
  ufw allow 51220/tcp >/dev/null
  ufw --force enable >/dev/null
  ok "ufw: ssh, http/https, 54001, 54002, 54230 tcp+udp, 54231, 51220"
}

setup_nginx() {
  step "nginx for $BAHAMUT_DOMAIN"
  sed -e "s#@DOMAIN@#$BAHAMUT_DOMAIN#g" -e "s#@WEB_PORT@#$WEB_PORT#g" \
    "$REPO_DIR/nginx/bahamut-web.conf" > /etc/nginx/sites-available/bahamut-web.conf
  ln -sf /etc/nginx/sites-available/bahamut-web.conf /etc/nginx/sites-enabled/bahamut-web.conf
  rm -f /etc/nginx/sites-enabled/default
  nginx -t
  systemctl reload nginx
  if [[ -n "${BAHAMUT_ACME_EMAIL:-}" ]]; then
    certbot --nginx --non-interactive --agree-tos --redirect -m "$BAHAMUT_ACME_EMAIL" \
      -d "$BAHAMUT_DOMAIN" -d "www.$BAHAMUT_DOMAIN" || warn "certbot failed; check that DNS for $BAHAMUT_DOMAIN points here, then run: sudo certbot --nginx"
  else
    warn "BAHAMUT_ACME_EMAIL is empty, so the site is served over plain HTTP."
  fi
  ok "nginx"
}

web_deploy() {
  step "Website ($WEB_REF)"
  if [[ ! -d "$WEB_DIR/.git" ]]; then
    as_user git clone "$WEB_REPO" "$WEB_DIR"
  fi
  as_user git -C "$WEB_DIR" fetch origin
  as_user git -C "$WEB_DIR" checkout --force "$WEB_REF"
  as_user git -C "$WEB_DIR" reset --hard "origin/$WEB_REF"
  # Build with the same env file the service uses, so SITE_URL etc. are baked in correctly.
  # --include=dev: NODE_ENV=production would otherwise skip the build tools.
  # shellcheck disable=SC2016  # expanded by the inner shell
  as_user bash -c 'set -Eeuo pipefail; set -a; source "$1"; set +a; cd "$2"
    npm ci --include=dev --no-audit --no-fund
    npm run build
    npm run migrate' _ "$WEB_ENV" "$WEB_DIR"
  systemctl enable bahamut-web.service
  systemctl restart bahamut-web.service
  ok "website running on 127.0.0.1:$WEB_PORT"
}

# ---- commands ------------------------------------------------------------------------------

cmd_install() {
  need_root install
  load_conf
  check_os
  install_packages
  create_user_and_dirs
  load_conf
  write_secrets
  setup_mariadb
  fetch_phoenix
  apply_overlay
  apply_phoenix_patches
  setup_python
  build_server
  setup_database
  install_units
  setup_firewall
  setup_nginx
  systemctl start bahamut-game.target
  web_deploy
  printf '\n%sBahamut XI is installed.%s\n' "$c_ok" "$c_off"
  echo "  Website:      https://$BAHAMUT_DOMAIN"
  echo "  Game status:  bahamut status"
  echo "  Make a GM:    sudo bahamut gm <account> 5   (after creating a character)"
  ln -sf "$REPO_DIR/bin/bahamut" /usr/local/bin/bahamut
}

cmd_update() {
  need_root update
  load_conf
  git -C "$REPO_DIR" pull --ff-only || warn "could not pull $REPO_DIR; using the settings already there"
  load_conf
  fetch_phoenix
  apply_overlay
  apply_phoenix_patches
  setup_python
  build_server
  systemctl stop bahamut-game.target
  cmd_backup_inner
  setup_database
  install_units
  systemctl start bahamut-game.target
  ok "game servers updated and restarted"
}

cmd_backup_inner() {
  local stamp file
  stamp="$(date +%Y%m%d-%H%M%S)"
  install -d -o "$BAHAMUT_USER" -g "$BAHAMUT_USER" -m 0750 "$BACKUP_DIR"
  for db in "$DB_NAME" "$WEB_DB_NAME"; do
    file="$BACKUP_DIR/$db-$stamp.sql.gz"
    mysqldump --protocol=socket -uroot --single-transaction --routines --triggers "$db" | gzip -6 > "$file"
    chown "$BAHAMUT_USER:$BAHAMUT_USER" "$file"; chmod 0640 "$file"
    ok "$file"
  done
  find "$BACKUP_DIR" -name '*.sql.gz' -mtime "+${BACKUP_KEEP_DAYS:-14}" -delete
}

cmd_backup() { need_root backup; load_conf; step "Backing up databases"; cmd_backup_inner; }

units_for() {
  case "${1:-all}" in
    game) echo bahamut-game.target ;;
    web) echo "${WEB_UNITS[*]}" ;;
    all) echo "bahamut-game.target ${WEB_UNITS[*]}" ;;
    *) die "unknown target '$1' (use game, web or all)" ;;
  esac
}

cmd_status() {
  load_conf
  local u state
  for u in "${GAME_UNITS[@]}" "${WEB_UNITS[@]}"; do
    state="$(systemctl is-active "$u" 2>/dev/null)" || true
    printf '  %-18s %s\n' "$u" "${state:-unknown}"
  done
  local online
  online="$(curl -fsS --max-time 2 http://127.0.0.1:8088/api/sessions 2>/dev/null || echo '?')"
  echo "  players online:    $online"
  echo "  phoenix commit:    $(git -C "$SERVER_DIR" rev-parse --short HEAD 2>/dev/null || echo 'not installed')"
}

cmd_logs() {
  local which="${1:-map}"
  [[ "$which" == "web" ]] && exec journalctl -u bahamut-web -f -n 200
  exec journalctl -u "bahamut-$which" -f -n 200
}

cmd_gm() {
  need_root gm
  load_conf
  local account="${1:-}" level="${2:-}"
  [[ -n "$account" && "$level" =~ ^[0-5]$ ]] || die "usage: sudo bahamut gm <account login> <0-5>"
  local n
  n="$(mysql_root -N "$DB_NAME" -e "UPDATE chars c JOIN accounts a ON a.id = c.accid SET c.gmlevel = $level WHERE a.login = '$(printf '%s' "$account" | sed "s/'/''/g")'; SELECT ROW_COUNT();")"
  ok "gmlevel $level on $n character(s) of $account (takes effect at next zone or login)"
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    install) cmd_install "$@" ;;
    update) cmd_update "$@" ;;
    web-update|web-deploy) need_root web-update; load_conf; web_deploy ;;
    apply) need_root apply; load_conf; apply_overlay; ok "restart with: sudo bahamut restart game" ;;
    build) need_root build; load_conf; apply_phoenix_patches; build_server ;;
    db-update) need_root db-update; load_conf; setup_database ;;
    start|stop|restart) need_root "$cmd"; load_conf; read -ra units <<<"$(units_for "${1:-all}")"; systemctl "$cmd" "${units[@]}" ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    backup) cmd_backup ;;
    gm) cmd_gm "$@" ;;
    help|-h|--help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$cmd' (see: bahamut help)" ;;
  esac
}

main "$@"
